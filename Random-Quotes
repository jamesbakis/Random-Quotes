import tkinter as tk
import random

root = tk.Tk()
quoteLabel = tk.Label(root, wraplength=250, text="Press right to see stoic quotes")
quotes = []
quote = None
# def quote_last(direction):
#     global quoteLabel
#     quoteLabel.configure(text="last")
    

def quote_next(direction=None):
    global quoteLabel, quotes, quote
    if quotes:
        quote = random.choice(quotes)
        quoteLabel.configure(text=quote)
    else:
        quoteLabel.configure(text="No quotes left!")
    
def add_quote(input):
    global quotes
    quote = input.get()
    quotes.append(quote)

def remove_quote(input):
    global quotes
    quotes.remove(input)

def main():

    global quotes

    with open("quotes1.txt", "r") as file:
        for line in file:
            quotes.append(line.rstrip())


    global root
    root.title("Random Quotes")
    root.configure(background="black")
    root.geometry("700x700+300+0")
    global quoteLabel
    quoteLabel.place(relx=0.5, rely=0.5, anchor='center')
    quoteLabel.tkraise() 
    root.bind_all("<Right>", quote_next)
    entry = tk.Entry(root, width=30)
    entry.pack(pady=10)
    add = tk.Button(root, text="Add Quote", command=lambda: add_quote(entry))
    add.pack(pady=5)
    global quote
    delete = tk.Button(root, text="Remove Quote", command=lambda: remove_quote(quote))
    delete.pack(pady=5)
    root.mainloop()

if __name__ == "__main__":
    main()