import tkinter as tk
import random
import sqlite3
import os

root = tk.Tk()
quoteLabel = tk.Label(root, wraplength=250, text="Press right to see stoic quotes")
if not os.path.exists("C:/RandomQuotes"):
        os.mkdir("C:/RandomQuotes") 
cx = sqlite3.connect("C:/RandomQuotes/test.db")
cur = cx.cursor() 
  
global_index = 0

def quote_next(direction=None):
    global global_index
    res = cur.execute("SELECT rowid, quote FROM quotes").fetchall()
    if res == []:
        quoteLabel.configure(text="No quotes left!")
    else:
        index = int(random.random() * len(res))
        selected_row = res[index]
        global_index = selected_row[0]
        quoteLabel.configure(text=selected_row[1])   
    


def add_quote(input):
    quote = "\"" + input.get() + "\""
    cur.execute(f"INSERT INTO quotes VALUES ('{quote}')")
    cx.commit()

def remove_quote():
    global global_index
    cur.execute(f"DELETE FROM quotes WHERE rowid = {global_index}")
    cx.commit()
def main(): 
    
    cur.execute("CREATE TABLE IF NOT EXISTS quotes(quote)")

    global root
    root.title("Random Quotes")
    root.configure(background="black")
    root.geometry("700x700+300+0")

    global quoteLabel
    quoteLabel.place(relx=0.5, rely=0.5, anchor='center')
    quoteLabel.tkraise() 
    root.bind_all("<Right>", quote_next)

    entry = tk.Entry(root, width=30)
    entry.pack(pady=10)
    
    root.bind_all("<Return>", lambda event: add_quote(entry))
    add = tk.Button(root, text="Add Quote", command=lambda: add_quote(entry))
    add.pack(pady=5)

    delete = tk.Button(root, text="Remove Quote", command=lambda: remove_quote())
    delete.pack(pady=5)
    
    root.mainloop()

if __name__ == "__main__":
    main()