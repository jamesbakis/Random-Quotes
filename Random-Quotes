import tkinter as tk

root = tk.Tk()
quoteLabel = tk.Label(root, text="Stoic Quotes")
def quote_last(direction):
    global quoteLabel
    quoteLabel.configure(text="last")
    

def quote_next(direction):
    global quoteLabel
    quoteLabel.configure(text="next")
    

def main():

    quotes = []

    with open("quotes.txt", "r") as file:
        for line in file:
            quotes.append(line.rstrip())

    global root
    root.title("Random Quotes")
    root.configure(background="black")
    root.geometry("700x700+300+0")
    global quoteLabel
    quoteLabel.place(relx=0.5, rely=0.5, anchor='center')
    quoteLabel.tkraise() 
    root.bind("<Right>", quote_next)
    root.bind("<Left>", quote_last)
    root.mainloop()

if __name__ == "__main__":
    main()