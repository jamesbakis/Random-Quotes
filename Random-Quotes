import tkinter as tk
import random, os

root = tk.Tk()
quoteLabel = tk.Label(root, wraplength=250, text="Press right to see stoic quotes")
quotes = []
quote = None
randomQuotesFile = "C:/RandomQuotes/randomquotes.txt"
directory = "C:/RandomQuotes"
    

def quote_next(direction=None):
    global quoteLabel, quotes, quote
    if quotes:
        quote = random.choice(quotes)
        quoteLabel.configure(text=quote)
    else:
        quoteLabel.configure(text="No quotes left!")
    
def add_quote(input):
    global quotes, randomQuotesFile
    with open(randomQuotesFile, "a") as file:
        quote = input.get()
        file.write("\n    \"" + quote + "\"")
        quotes.append(quote)

def remove_quote(input):
    global quotes, randomQuotesFile
    if input in quotes:
        quotes.remove(input)

        with open(randomQuotesFile, "w") as file:
            for quote in quotes:
                file.write(quote + "\n")

def main():

    global quotes, randomQuotesFile, root, quoteLabel, quote, directory

    os.mkdir(directory)
    
    open(randomQuotesFile, "x")
    root.title("Random Quotes")
    root.configure(background="black")
    root.geometry("700x700+300+0")
    root.bind_all("<Right>", quote_next)

    quoteLabel.place(relx=0.5, rely=0.5, anchor='center')
    quoteLabel.tkraise() 
    
    entry = tk.Entry(root, width=30)
    entry.pack(pady=10)

    add = tk.Button(root, text="Add Quote", command=lambda: add_quote(entry))
    add.pack(pady=5)
    
    delete = tk.Button(root, text="Remove Quote", command=lambda: remove_quote(quote))
    delete.pack(pady=5)
    root.mainloop()

if __name__ == "__main__":
    main()