    if cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='quotes'"):
        pass
    else:
        cur.execute("CREATE TABLE quotes(quote)")

    global root
    root.title("Random Quotes")
    root.configure(background="black")
    root.geometry("700x700+300+0")

    global quoteLabel
    quoteLabel.place(relx=0.5, rely=0.5, anchor='center')
