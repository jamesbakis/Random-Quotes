import tkinter as tk
import random
import sqlite3

root = tk.Tk()
quoteLabel = tk.Label(root, wraplength=250, text="Press right to see stoic quotes")
quotes = []
cx = sqlite3.connect("test.db")
cur = cx.cursor()    

def quote_next(direction=None):
    res = cur.execute("SELECT quote FROM quotes")
    quoteLabel.configure(text=res.fetchall()[1][0])   

def add_quote():
    pass
def main():
    
    cur.execute(""" INSERT INTO quotes VALUES
        ('Marcus Aurelius'),
        ('Seneca')
        """)
    res = cur.execute("SELECT quote FROM quotes")
    print(res.fetchall()[1])
    column_length = cur.execute("SELECT COUNT(*) AS column_length FROM quotes")
    print(column_length.fetchone()[0]) 
    global quotes

    with open("quotes.txt", "r") as file:
        for line in file:
            quotes.append(line.rstrip())


    global root
    root.title("Random Quotes")
    root.configure(background="black")
    root.geometry("700x700+300+0")
    global quoteLabel
    quoteLabel.place(relx=0.5, rely=0.5, anchor='center')
    quoteLabel.tkraise() 
    root.bind_all("<Right>", quote_next)

    entry = tk.Entry(root, width=30)
    entry.pack(pady=10)
    
    root.bind_all("<Return>", lambda event: add_quote(entry))
    add = tk.Button(root, text="Add Quote", command=lambda: add_quote(entry))
    add.pack(pady=5)
    
    root.mainloop()

if __name__ == "__main__":
    main()