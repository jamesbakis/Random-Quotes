import tkinter as tk
import random
import sqlite3

root = tk.Tk()
quoteLabel = tk.Label(root, wraplength=250, text="Press right to see stoic quotes")
cx = sqlite3.connect("test.db")
cur = cx.cursor()    

def quote_next(direction=None):
    column_length = cur.execute("SELECT COUNT(*) AS column_length FROM quotes")
    index = int(random.random() * column_length.fetchone()[0])
    res = cur.execute("SELECT quote FROM quotes")
    quoteLabel.configure(text=res.fetchall()[index][0])   

def add_quote(input):
    quote = "\"" + input.get() + "\""
    cur.execute(f"INSERT INTO quotes VALUES ('{quote}')")
    cx.commit()

